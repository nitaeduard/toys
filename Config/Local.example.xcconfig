// Copy to Local.xcconfig (git-ignored) and fill in your own values.
// Scripts/build-snowfall.sh passes it to xcodebuild, overriding the project's
// empty signing settings, so personal signing data never lands in git.

CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = YOUR_TEAM_ID
PRODUCT_BUNDLE_IDENTIFIER = com.example.toys.$(PRODUCT_NAME:rfc1034identifier:lower)
